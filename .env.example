PARADISE_API_KEY=sk_sua_chave_secreta_aqui
PARADISE_PRODUCT_HASH=
PARADISE_POSTBACK_URL=
PARADISE_UPSELL_URL=

# Se true, o backend gera nome, e-mail e telefone a cada Pix.
# O documento ainda deve ser um documento sintetico/autorizado pela Paradise,
# configurado abaixo, para evitar coletar dados de criancas.
PARADISE_USE_GENERATED_CUSTOMER=true

# Dados enviados a Paradise.
PARADISE_CUSTOMER_NAME=Nome do Responsavel
PARADISE_CUSTOMER_EMAIL=responsavel@example.com
PARADISE_CUSTOMER_DOCUMENT=documento_sintetico_fornecido_pela_paradise
PARADISE_CUSTOMER_PHONE=11999999999
